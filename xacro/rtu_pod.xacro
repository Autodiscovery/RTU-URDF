<?xml version="1.0"?>
<!-- RTU track pod (left or right). Mirror-symmetric about the
     robot X-Z plane: instantiate once per side with `side`=1 (left)
     or `side`=-1 (right); `prefix` is the link-name prefix to use. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="rtu_pod" params="prefix side parent *origin">
    <joint name="${prefix}_pod_joint" type="fixed">
      <parent link="${parent}"/><child link="${prefix}_pod"/>
      <xacro:insert_block name="origin"/>
    </joint>
    <link name="${prefix}_pod"/>
    <link name="${prefix}_battery">
        <inertial>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <mass value="35.047" />
          <inertia ixx="0.273219" ixy="1.71507e-11" ixz="-6.39807e-11" iyy="0.342145" iyz="3.17912e-10" izz="0.404856" />
        </inertial>
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry><mesh filename="meshes/${prefix}_battery.stl" scale="1 1 1" /></geometry>
          <material name="grey" />
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry><mesh filename="meshes/${prefix}_battery.stl" scale="1 1 1" /></geometry>
        </collision>
      </link>
    <joint name="${prefix}_battery_joint" type="fixed">
      <parent link="${prefix}_pod"/><child link="${prefix}_battery"/>
      <origin xyz="0.0475 0 0.265" rpy="0 0 0"/>
    </joint>
    <link name="${prefix}_battery_bay_post_front_lower">
        <inertial>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <mass value="0.440782" />
          <inertia ixx="0.00236355" ixy="1.09775e-16" ixz="6.43216e-19" iyy="0.000265879" iyz="-3.74494e-17" izz="0.00213383" />
        </inertial>
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry><mesh filename="meshes/${prefix}_battery_bay_post_front_lower.stl" scale="1 1 1" /></geometry>
          <material name="black" />
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry><mesh filename="meshes/${prefix}_battery_bay_post_front_lower.stl" scale="1 1 1" /></geometry>
        </collision>
      </link>
    <joint name="${prefix}_battery_bay_post_front_lower_joint" type="fixed">
      <parent link="${prefix}_pod"/><child link="${prefix}_battery_bay_post_front_lower"/>
      <origin xyz="0.2 0 0.19" rpy="0 0 0"/>
    </joint>
    <link name="${prefix}_battery_bay_post_front_upper">
        <inertial>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <mass value="0.440782" />
          <inertia ixx="0.00236355" ixy="-6.22061e-16" ixz="-7.08967e-17" iyy="0.000265879" iyz="-3.01883e-16" izz="0.00213383" />
        </inertial>
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry><mesh filename="meshes/${prefix}_battery_bay_post_front_upper.stl" scale="1 1 1" /></geometry>
          <material name="black" />
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry><mesh filename="meshes/${prefix}_battery_bay_post_front_upper.stl" scale="1 1 1" /></geometry>
        </collision>
      </link>
    <joint name="${prefix}_battery_bay_post_front_upper_joint" type="fixed">
      <parent link="${prefix}_pod"/><child link="${prefix}_battery_bay_post_front_upper"/>
