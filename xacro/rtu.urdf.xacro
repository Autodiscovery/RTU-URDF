<?xml version="1.0"?>
<!-- Autodiscovery RTU (Robotic Traction Unit) - top-level xacro.
     Frames follow REP-103/105: +X forward (Front_Panel end), +Y left,
     +Z up, metres. base_footprint is on the ground plane, centred
     between the two track pods. Expand with:
       xacro rtu.urdf.xacro > rtu.urdf
     See README.md for the full file layout and how to edit each part. -->
<robot name="rtu" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="rtu_pod.xacro"/>
  <xacro:include filename="rtu_mast.xacro"/>
  <xacro:include filename="head_lite.xacro"/>

  <material name="white"><color rgba="0.92 0.92 0.92 1" /></material>
  <material name="black"><color rgba="0.12 0.12 0.12 1" /></material>
  <material name="red"><color rgba="0.8 0.1 0.1 1" /></material>
  <material name="grey"><color rgba="0.55 0.55 0.58 1" /></material>

  <link name="base_footprint"/>
  <joint name="base_link_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 0.13" rpy="0 0 0"/>
  </joint>
  <link name="base_link"/>

  <xacro:rtu_pod prefix="left" side="1" parent="base_link">
    <origin xyz="0 0.42 0" rpy="0 0 0"/>
  </xacro:rtu_pod>
  <xacro:rtu_pod prefix="right" side="-1" parent="base_link">
    <origin xyz="0 -0.42 0" rpy="0 0 0"/>
  </xacro:rtu_pod>

  <xacro:rtu_mast parent="base_link">
    <origin xyz="-0.05 0 0.18" rpy="0 0 0"/>
  </xacro:rtu_mast>

  <!-- HEAD-lite navigation payload: centred underneath the front-lower
       mast crossbeam, mounted upside down (see head_lite.xacro). -->
  <xacro:head_lite parent="mast_crossbeam_front_lower">
    <origin xyz="0 0 -0.04" rpy="0 0 0"/>
  </xacro:head_lite>

</robot>
