<?xml version="1.0"?>
<!-- RTU sensor mast: the 4080-extrusion gantry on top of the two pods,
     carrying the electronics box, GPS mounts and the HEAD-lite payload
     mount point (mast_crossbeam_front_lower). Not mirror-symmetric as a
     macro (asymmetric electronics box placement), so kept as one block. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="rtu_mast" params="parent *origin">
    <joint name="mast_joint" type="fixed">
      <parent link="${parent}"/><child link="mast"/>
      <xacro:insert_block name="origin"/>
    </joint>
    <link name="mast"/>
    <link name="mast_bracket_front_left_mid_lower">
        <inertial>
          <origin xyz="0.014489 0.014489 0" rpy="0 0 0" />
          <mass value="0.114793" />
          <inertia ixx="7.04348e-05" ixy="2.53285e-05" ixz="2.80819e-13" iyy="7.04348e-05" iyz="2.80376e-13" izz="9.67612e-05" />
        </inertial>
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry><mesh filename="meshes/mast_bracket_front_left_mid_lower.stl" scale="1 1 1" /></geometry>
          <material name="grey" />
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry><mesh filename="meshes/mast_bracket_front_left_mid_lower.stl" scale="1 1 1" /></geometry>
        </collision>
      </link>
    <joint name="mast_bracket_front_left_mid_lower_joint" type="fixed">
